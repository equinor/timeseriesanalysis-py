{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "pull-request-title-pattern": "chore: release ${version}",
    "packages": {
        ".": {
            "release-type": "python",
            "package-name": "timeseriesanalysis",
            "extra-files": [
                {
                    "type": "toml",
                    "path": "uv.lock",
                    "jsonpath": "$.package[?(@.name=='timeseriesanalysis')].version"
                }
            ]
        }
    }
}
